{
  "name": "better-auth-attio-plugin",
  "version": "0.3.3",
  "description": "Sync users, workspaces and arbitrary objects between your Better Auth app and Attio",
  "keywords": [
    "api",
    "attio",
    "better-auth"
  ],
  "homepage": "https://github.com/tobimori/better-auth-attio-plugin",
  "bugs": {
    "url": "https://github.com/tobimori/better-auth-attio-plugin/issues"
  },
  "license": "MIT",
  "author": "Tobias Möritz <tobias@moeritz.io> (https://moeritz.io)",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobimori/better-auth-attio-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test",
    "ci": "pnpm run fix && pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm run ci",
    "local-release": "changeset version && changeset publish",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "better-auth": "^1.7.2",
    "zod": "^4.0.17"
  },
  "packageManager": "pnpm@10.22.0"
}
